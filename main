-- ==========================================
-- 4. HIỆU ỨNG VÀ KÉO THẢ (DRAG & TWEEN)
-- ==========================================
local function makeDraggable(gui)
    local dragging, dragStart, startPos
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = gui.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

makeDraggable(FloatBtn)
makeDraggable(MainFrame)

-- Hiệu ứng ẩn/hiện mượt mà
local function toggleUI()
    if MainFrame.Visible then
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 320, 0, 0)})
        tween:Play()
        tween.Completed:Wait()
        MainFrame.Visible = false
        FloatBtn.Visible = true
    else
        MainFrame.Size = UDim2.new(0, 320, 0, 0)
        MainFrame.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 320, 0, 180)}):Play()
        FloatBtn.Visible = false
    end
end

FloatBtn.MouseButton1Click:Connect(toggleUI)
CloseBtn.MouseButton1Click:Connect(toggleUI)

UIS.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.RightControl then toggleUI() end
end)

-- Viền RGB tự động đổi màu
RunService.RenderStepped:Connect(function()
    local rgb = Color3.fromHSV(tick() % 3 / 3, 1, 1)
    MainStroke.Color = rgb
    FloatStroke.Color = rgb
    Title.TextColor3 = rgb
end)

