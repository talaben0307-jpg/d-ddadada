-- BỘ DÒ TÍN HIỆU (REMOTE SPY) - CHẠY VÀ MỞ F9
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

print("🟢 Đã bật Máy Quét! Mở F9, vào máy ấp hoặc bấm nút Exit để xem tín hiệu...")

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    
    -- Bắt các tín hiệu gửi lên máy chủ (Server)
    if method == "FireServer" or method == "InvokeServer" then
        local args = {...}
        print("=======================================")
        print("🎯 BẮT ĐƯỢC LỆNH TỪ: " .. tostring(self.Name))
        print("📝 ĐƯỜNG DẪN: " .. tostring(self:GetFullName()))
        
        -- In ra các thông số đi kèm
        for i, v in ipairs(args) do
            print("   ↳ Tham số " .. tostring(i) .. ": " .. tostring(v) .. " (" .. type(v) .. ")")
        end
        print("=======================================")
    end
    
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)
