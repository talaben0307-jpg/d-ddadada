local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- 1. HÀM TỰ ĐỘNG TÌM & BẤM NÚT EXIT SIÊU TỐC
-- ==========================================
local function emergencyExit()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    for _, gui in pairs(playerGui:GetDescendants()) do
        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
            -- Nhận diện nút có chữ Exit
            if gui.Name:lower():match("exit") or (gui:IsA("TextButton") and gui.Text:lower():match("exit")) then
                if firesignal then
                    firesignal(gui.MouseButton1Click)
                    firesignal(gui.MouseButton1Down)
                    firesignal(gui.MouseButton1Up)
                else
                    local GuiService = game:GetService("GuiService")
                    GuiService.SelectedCoreObject = gui
                    game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                    game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                end
                print("🚨 ĐÃ BẤM EXIT KHẨN CẤP! BẢO VỆ TRỨNG THÀNH CÔNG!")
                return true
            end
        end
    end
    return false
end

