local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- 1. DỌN DẸP GIAO DIỆN CŨ (TRÁNH TRÙNG LẶP)
-- ==========================================
local uiName = "ZelynxEggProtector"
if CoreGui:FindFirstChild(uiName) then 
    CoreGui[uiName]:Destroy() 
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = uiName
ScreenGui.Parent = (gethui and gethui()) or CoreGui

-- ==========================================
-- 2. HÀM TỰ ĐỘNG BẤM NÚT EXIT SIÊU TỐC
-- ==========================================
local function emergencyExit()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    for _, gui in pairs(playerGui:GetDescendants()) do
        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
            -- Nhận diện nút có chữ Exit hoặc tên là Exit
            if gui.Name:lower():match("exit") or (gui:IsA("TextButton") and gui.Text:lower():match("exit")) then
                if firesignal then
                    firesignal(gui.MouseButton1Click)
                    firesignal(gui.MouseButton1Down)
                    firesignal(gui.MouseButton1Up)
                else
                    -- Dự phòng cho các Executor không hỗ trợ firesignal
                    local GuiService = game:GetService("GuiService")
                    GuiService.SelectedCoreObject = gui
                    game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                    game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                end
                print("🚨 ĐÃ BẤM NÚT EXIT KHẨN CẤP!")
                return true
            end
        end
    end
    return false
end

